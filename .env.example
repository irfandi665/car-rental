# --- PostgreSQL ---
POSTGRES_USER=rental
POSTGRES_PASSWORD=rental_dev_pass
POSTGRES_DB=rental_db
# Host "db" = nama service di docker compose
DATABASE_URL=postgresql://rental:rental_dev_pass@db:5432/rental_db?schema=public

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# --- Storage S3 (SeaweedFS lokal) ---
S3_ENDPOINT=http://storage:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey
S3_BUCKET=rental-files
S3_FORCE_PATH_STYLE=true

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Umum ---
APP_URL=http://localhost:3000
BUSINESS_NAME=Rental Mobil
PAYMENT_INSTRUCTIONS=Pembayaran dilakukan tunai saat pickup atau transfer ke BCA 1234567890 a.n. Rental Mobil. Admin akan mengonfirmasi via WhatsApp.

# --- Penerima notifikasi admin (pisahkan dengan koma, boleh kosong) ---
ADMIN_NOTIFY_WHATSAPP=6281200000000
ADMIN_NOTIFY_EMAIL=admin@example.com

# --- WhatsApp: log | twilio ---
WHATSAPP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WA_MODE=freeform
TWILIO_CONTENT_SID_CUSTOMER=
TWILIO_CONTENT_SID_ADMIN=

# --- Email: smtp | log ---
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Rental Mobil <no-reply@rental.test>

# --- Endpoint internal ---
CRON_SECRET=<hasil-perintah-di-atas>